# Copy to .env and fill in. All optional except ADMIN_API_KEY for admin routes.

# HTTP port (default 5000)
PORT=5000

# sqlite visitor DB path (default ./db/visitors.sqlite; compose uses
# /app/storage/visitors.sqlite)
DB_PATH=

# Shared secret for admin routes (GET /api/v1/visitors,
# POST /api/v1/cache/invalidate), sent as the `x-api-key` header.
# Generate with: openssl rand -hex 32
# Empty = admin routes always return 401.
ADMIN_API_KEY=
